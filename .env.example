MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password
MYSQL_DATABASE=taipei_day_trip
MYSQL_UNIX_SOCKET=/tmp/mysql.sock

# On Ubuntu EC2, the socket is usually:
# MYSQL_UNIX_SOCKET=/var/run/mysqld/mysqld.sock

# For a remote MySQL server, leave MYSQL_UNIX_SOCKET empty and configure:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
